PORT=4000
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/team1
# Separate database used by `npm test`; it is wiped by the test run.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/team1_test
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# VIP / childcare categories. Unset: on in development, off in production.
# VIP_CATEGORIES=off

# --- Object storage (verification documents) ---
# local (default disk under backend/uploads) | s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=local
# UPLOAD_DIR=C:/data/hojii-uploads
# S3_BUCKET=hojiigo-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# --- SMS / OTP ---
# console (default, logs code) | africastalking | twilio
OTP_PROVIDER=console
# Force returning the code in JSON (never enable with a live SMS provider in production).
# OTP_EXPOSE_DEV_CODE=false
# Africa's Talking (https://africastalking.com)
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_FROM=
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+251...

# --- Push + SMS alerts ---
# Generate with: npx web-push generate-vapid-keys
# Leave blank to disable browser push (in-app notifications still work).
VAPID_PUBLIC_KEY=BCArfHXexFfEUBVRdfqh2zkirDK0wzDlinNBDuBpdtQZQFd3RllojnequFb2Z8Frk5YvD7hbVBSedaKcSLATYdI
VAPID_PRIVATE_KEY=sdGRG9KMYsyOykycHIsGOfYmIUf1YkJD7EtjWmzQ0j4
VAPID_SUBJECT=mailto:pilot@hojiigo.local
# Also SMS high-priority events (selected, paired, cancelled, paid) via OTP_PROVIDER.
# NOTIFY_SMS=true

# --- Payments / escrow ---
# off (default) | manual (record-only, employer settles) | mock_escrow (record only — no bank or fake transfer; admin confirms then records payout)
# chapa — licensed Chapa hosted checkout + refund/transfer (set CHAPA_SECRET_KEY)
# Legal review still required before holding real pilot funds (SRS §12).
PAYMENTS_MODE=mock_escrow
# CHAPA_SECRET_KEY=CHASECK-...
# CHAPA_PUBLIC_KEY=CHAPUBK-...
# Optional: public API origin so Chapa can hit /api/payments/chapa/callback and webhooks
# PUBLIC_API_URL=https://api.example.com
# CHAPA_BASE_URL=https://api.chapa.co/v1

# --- Writing assist (job descriptions + apply pitches) ---
# off | template (default, no external API) | openai (OpenAI-compatible Chat Completions)
LLM_PROVIDER=template
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
